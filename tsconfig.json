{
  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  "forceConsistentCasingInFileNames": true,
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "src/shared/types/**/*.d.ts",
    "types/shims-splide.d.ts",
    "types/images.d.ts",
    "src/shared/utils/type-guards",
    "types/**/*.d.ts"
  ],
  "compilerOptions": {
    "types": ["@nuxt/schema", "@nuxtjs/i18n"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./src/*"],
      "@root/*": ["./*"],
      "@shared/*": ["./src/shared/*"],
      "@widgets/*": ["./src/widgets/*"],
      "@pages/*": ["./src/pages/*"],
      "#components/*": [".nuxt/components/*"],
      "#imports": ["./.nuxt/imports.d.ts"],
      "#app": ["./.nuxt/imports.d.ts"],
      "#build/*": ["./.nuxt/*"]
    }
  }
}
